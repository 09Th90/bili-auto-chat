{
  "manifest_version": 3,
  "name": "B站自动聊天",
  "version": "0.2.0",
  "description": "AI 自动回复 B 站评论/消息/私信，支持多线程独立上下文持续对话",
  "permissions": ["storage", "alarms", "cookies", "notifications", "scripting", "declarativeNetRequest"],
  "host_permissions": ["*://*.bilibili.com/*", "http://127.0.0.1/*", "http://localhost/*", "https://apihub.agnes-ai.com/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "bili_headers",
        "enabled": true,
        "path": "rules/bili-headers.json"
      }
    ]
  },
  "externally_connectable": {
    "matches": ["http://127.0.0.1/*", "http://localhost/*"]
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "B站自动聊天"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["*://*.bilibili.com/*"],
      "js": ["content/bili-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
